#!/bin/sh
# CubeLinux startup
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /run /var/log /var/run
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
hostname -F /etc/hostname
echo
printf '\033[1;34m   ###\033[1;32m   CubeLinux\033[0m\n'
printf '\033[1;34m  #####\033[0m   real Linux for the Nintendo GameCube\n'
printf '\033[1;34m   ###\033[0m\n'
echo
echo "  $(. /etc/os-release; echo $PRETTY_NAME) - kernel $(uname -r)"
echo "  $(grep MemTotal /proc/meminfo)"
grep -q cubelinux.text /proc/cmdline || echo "  Starting the desktop..."
sleep 2
